{
  "name": "video-studio",
  "version": "1.0.0",
  "description": "Remotion video studio for creating beautiful videos",
  "main": "index.js",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "prepare:project": "node scripts/prepare-project.mjs",
    "build": "remotion render src/index.ts main-video output/video.mp4",
    "build:preview": "remotion render src/index.ts main-video output/preview.mp4 --scale=0.5",
    "still": "remotion still src/index.ts main-video output/frame.png --frame=30",
    "compositions": "remotion compositions src/index.ts"
  },
  "keywords": [
    "remotion",
    "video",
    "animation"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@remotion/bundler": "^4.0.507",
    "@remotion/cli": "^4.0.507",
    "@remotion/player": "^4.0.507",
    "@remotion/renderer": "^4.0.507",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "^4.0.507"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^5.5.0"
  }
}
