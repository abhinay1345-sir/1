{
  "permissions": {
    "allow": [
      "Bash(node src/pipeline.js *)",
      "Bash(rclone lsd *)",
      "Bash(rclone lsf *)",
      "Bash(mountpoint *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/validate-json.cjs"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "code-review@claude-plugins-official": true
  }
}
