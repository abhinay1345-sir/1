{
  "name": "documentary-factory",
  "version": "1.0.0",
  "description": "Automated documentary video creation pipeline",
  "main": "src/pipeline.js",
  "type": "module",
  "scripts": {
    "create": "node src/pipeline.js --mode create",
    "resume": "node src/pipeline.js --mode resume",
    "agent": "node src/pipeline.js --mode agent",
    "preview": "node src/pipeline.js --mode preview",
    "render": "node src/pipeline.js --mode render",
    "scrape": "node scraper.js",
    "install-browsers": "npx playwright install chromium"
  },
  "keywords": [
    "documentary",
    "video",
    "automation",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=24.14.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "argparse": "^3.0.0",
    "axios": "^1.7.0",
    "dotenv": "^16.4.0",
    "fluent-ffmpeg": "^2.1.2",
    "pexels": "^1.0.2",
    "playwright": "^1.44.0",
    "uuid": "^10.0.0"
  }
}
