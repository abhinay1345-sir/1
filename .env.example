# Documentary Factory Environment Variables
# Copy this file to .env and fill in your values

# Anthropic API Key (required for script generation)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Pexels API Key (free at pexels.com/api)
PEXELS_API_KEY=your-pexels-key

# Stability AI Key (optional, for custom image generation)
STABILITY_API_KEY=your-stability-key

# Suno API Key (optional, for AI music generation)
SUNO_API_KEY=your-suno-key

# Google Drive mount point (default)
DRIVE_MOUNT=~/gdrive

# Output base path on Drive
OUTPUT_BASE=~/gdrive/documentary-factory
